# Copy to .env and fill in. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set to 1 to force SSL (e.g. running migrations against Railway's public proxy URL)
DB_REQUIRE_SSL=
# Password used by `flask seed` for demo users
SEED_PASSWORD=
# Secret used to sign JWTs (use a long random value, never commit a real one)
JWT_SECRET_KEY=change-me
# Access token lifetime in minutes (default 60)
JWT_EXPIRES_MINUTES=60
# Optional Flask secret key
SECRET_KEY=
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Enable the Swagger UI and GET /api/openapi.json. Defaults to false when
# FLASK_ENV=production, true otherwise. Set explicitly to override (BE-DOC-02).
SWAGGER_ENABLED=
